{
  "rules": {
    ".read": false,
    ".write": false,
    "products": { ".read": true, "$id": { ".write": "auth != null && root.child('admins').child(auth.uid).val() === true" } },
    "settings": { ".read": true, ".write": "auth != null && root.child('admins').child(auth.uid).val() === true" },
    "admins": { ".read": false, ".write": false },
    "orders": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "!data.exists() && newData.hasChildren(['customer','items','total','status'])",
        ".validate": "newData.child('status').val() === 'pending'"
      }
    }
  }
}