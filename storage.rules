rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }
    match /product-images/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    match /branding/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
  }
}